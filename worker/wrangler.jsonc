{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sharecapsule-prepare-research",
  "main": "src/index-v2.js",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api.prepare.sharecapsule.app",
      "custom_domain": true
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://learning.sharecapsule.app,https://prepare.sharecapsule.app,http://localhost:8000,http://localhost:8080",
    "OPENAI_MODEL": "gpt-5-mini"
  },
  "observability": {
    "enabled": true
  }
}
